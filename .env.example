# Backend runtime
NODE_ENV=production
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
# For a database on the same cPanel server, this can be more reliable than TCP.
# When set, DB_SOCKET_PATH is used instead of DB_HOST and DB_PORT.
DB_SOCKET_PATH=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
AUTH_USER_CACHE_TTL_MS=30000

# Performance logging
REQUEST_LOGGING_ENABLED=true
LOG_ALL_REQUESTS=false
SLOW_REQUEST_MS=800
DB_LOG_ALL_QUERIES=false

# Warn before creating an exact repeat for the same customer within this period.
DUPLICATE_ORDER_WINDOW_HOURS=72
DB_SLOW_QUERY_MS=500
